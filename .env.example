# ---------------------------------------------------------------------------
# The Crazy Game — Rules Assistant
#
# Copy this file to `.env.local` for local development, and add the same
# variables in the Vercel dashboard (Settings → Environment Variables) for the
# deployed app. Never commit a filled-in copy of this file.
# ---------------------------------------------------------------------------

# --- Anthropic -------------------------------------------------------------
# From https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# The project specification requires Claude Sonnet 5 — the rules contain
# multi-step conditional logic that needs it. Leave this as-is unless you have
# a specific reason to change it.
ANTHROPIC_MODEL=claude-sonnet-5

# --- MongoDB Atlas ---------------------------------------------------------
# From the Atlas dashboard → Connect → Drivers. Remember to URL-encode any
# special characters in the password.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=tcg_rules_assistant
# Optional — defaults to "interactions"
# MONGODB_COLLECTION=interactions

# --- Admin page (/admin) ---------------------------------------------------
# Generate with:  npm run hash-password -- "your-password"
ADMIN_PASSWORD_HASH=scrypt:16384:8:1:...:...
# Generate with:  npm run generate-secret
ADMIN_SESSION_SECRET=

# --- Rate limiting (optional — sensible defaults are built in) -------------
# RATE_LIMIT_PER_IP=15
# RATE_LIMIT_PER_SESSION=10
# RATE_LIMIT_WINDOW_SECONDS=60

# --- QR code (optional) ----------------------------------------------------
# Used as the default target for `npm run generate-qr`
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
